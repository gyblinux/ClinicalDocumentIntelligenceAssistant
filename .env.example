# Required. Create at https://platform.deepseek.com/
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key

# DeepSeek is OpenAI-compatible, but it uses Chat Completions rather than
# OpenAI's Responses API.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Maximum model <-> tool round trips for one user turn.
AGENT_MAX_STEPS=8

# Local retrieval services
TEI_URL=http://127.0.0.1:8080
TEI_MODEL=BAAI/bge-small-en-v1.5
TEI_EMBEDDING_DIMENSION=384
TEI_BATCH_SIZE=32

QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
