# Required. Create at https://platform.deepseek.com/
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key

# DeepSeek is OpenAI-compatible, but it uses Chat Completions rather than
# OpenAI's Responses API.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Maximum model <-> tool round trips for one user turn.
AGENT_MAX_STEPS=8

